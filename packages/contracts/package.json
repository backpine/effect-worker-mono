{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "API contract definitions for Effect Worker (HTTP and RPC)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.build.json",
    "check": "bun --bun tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo/db": "workspace:^",
    "@repo/domain": "workspace:^",
    "effect": "catalog:"
  }
}
