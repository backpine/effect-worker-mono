{
  "name": "@repo/db",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Database schema and queries for Effect Worker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "import": "./dist/queries/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.build.json",
    "check": "bun --bun tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:check": "bun --bun drizzle-kit check",
    "db:migrate": "bun --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@repo/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "effect": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "pg": "8.23.1"
  }
}
