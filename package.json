{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@effect/atom-react": "4.1.5",
      "@effect/sql-pg": "4.1.5",
      "effect": "4.1.5"
    }
  },
  "scripts": {
